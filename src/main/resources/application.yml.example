server:
  port: 8080

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/love
    username: YOUR_DB_USERNAME
    password: YOUR_DB_PASSWORD
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        format_sql: true
    open-in-view: false


logging:
  level:
    org.hibernate.SQL: debug

app:
  jwt:
    secret: "최소_32자_이상_랜덤_문자열로_바꿔"
    accessTokenMinutes: 60
  openai:
    api-key: "YOUR_OPENAI_API_KEY_HERE"
  bert:
    # BERT 감정 분류 서비스 URL (Mac은 5000이 AirPlay라 5001 권장)
    service-url: "http://localhost:5001"

management:
  health:
    redis:
      enabled: false
